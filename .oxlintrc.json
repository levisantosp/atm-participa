{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["ui/**", "api-client/**"],
  "plugins": ["typescript", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "eqeqeq": "error"
  },
  "env": {
    "builtin": true
  },
  "options": {
    "typeAware": true
  }
}
