fmt:
  find . -type f -name '*.go' -exec go tool gofumpt -w {} +
  find . -type f -name '*.go' -exec go tool golines -m 80 -w {} +
  find . -type f -name '*.go' -exec go tool goimports -w {} +

lint *args:
  go tool golangci-lint run {{ args }}

lintf:
  go tool golangci-lint run --fix

build:
  go build ./...
